/* ---------- ADREN EDITING ----------> */

#ui-boost-counter .ui-boost-base {
    background: rgba(255, 255, 255, 0);
    height: 5px;
    margin-bottom: 15px;
}

.ui-boost-base .ui-bar-inner {
    border-radius: inherit;
    width: 20px;
    height: 10px;
    border: 2px solid black;
    background: transparent;
}

#ui-boost-counter-0 .ui-bar-inner {
    background: linear-gradient(270deg, #00eaff, #00ffcc, #33ff66, #ffee00, #ff8800, #ff3366, #00eaff);
    background-size: 400% 400%;
    animation: adrenGradient 22s ease infinite;
}

#ui-boost-counter-1 .ui-bar-inner {
    background: linear-gradient(270deg, #00eaff, #00ffcc, #33ff66, #ffee00, #ff8800, #ff3366, #00eaff);
    background-size: 400% 400%;
    animation: adrenGradient 16s ease infinite;
}

#ui-boost-counter-2 .ui-bar-inner {
    background: linear-gradient(270deg, #00eaff, #00ffcc, #33ff66, #ffee00, #ff8800, #ff3366, #00eaff);
    background-size: 400% 400%;
    animation: adrenGradient 7s ease infinite;
}

#ui-boost-counter-3 .ui-bar-inner {
    background: linear-gradient(270deg, #00eaff, #00ffcc, #33ff66, #ffee00, #ff8800, #ff3366, #00eaff);
    background-size: 400% 400%;
    animation: adrenGradient 3s ease infinite;
}

@keyframes adrenGradient {
    0% {
        background-position: 0% 50%;
    }
    50% {
        background-position: 100% 50%;
    }
    100% {
        background-position: 0% 50%;
    }
}


/* ---------- HEALTH EDITING ----------> */

#ui-health-actual.ui-bar-inner {
    background: linear-gradient(270deg, #00eaff, #00ffcc, #33ff66, #ffee00, #ff8800, #ff3366, #00eaff);
    background-size: 400% 400%;
    animation: healthGradient 50s ease infinite;
    border-radius: 4px;
}

@keyframes healthGradient {
    0% {
        background-position: 0% 50%;
    }
    50% {
        background-position: 100% 50%;
    }
    100% {
        background-position: 0% 50%;
    }
}


