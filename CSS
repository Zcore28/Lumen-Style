/* ---------- BACKGROUND ----------> */

#background {
    background-image: linear-gradient(to top, rgba(43, 126, 143, 0.52), rgba(135, 138, 81, .52)), linear-gradient(to right, rgba(250, 245, 136, .11), rgba(93, 80, 60, .3)), url(https://64.media.tumblr.com/62d861ca60d90a092a586e3c6c8fafe9/181a0a33b86ea34a-1f/s540x810/b416661bec51dd422fe221e5d3ba8e1286050548.gif) !important;
    background-size: cover;
    background-position: center bottom;
    background-repeat: no-repeat;
}

#start-row-header {
    background-image: url(https://i.imgur.com/I4uYvnX.png) !important;
}

#start-top-left,
#featured-streamers,

/* nostalgic reason */

#start-bottom-left,
#start-bottom-middle {
    visibility: visible !important;
}


/* ---------- SCALE ADJUSTMENTS ----------> */

@media (max-height: 720px) {
    #start-bottom-right {
        transform: scale(.8);
        transform-origin: bottom right;
    }
}


/* ---------- KILL LEADER ----------> */

#ui-kill-leader-icon {
    background-color: rgba(0, 0, 0, 0.4);
    background-image: url(https://i.imgur.com/1PmSqQx.png);
}

#ui-kill-leader-wrapper {
    color: #ffe741;
    position: absolute;
    right: 112px;
    top: 0;
}


/* ---------- MAP INFO ----------> */

#ui-map-info {
    color: #67e84c;
}

.gas-icon {
    background-image: url(https://i.imgur.com/NNGPVcu.png);
}

.danger-icon {
    background-image: url(https://i.imgur.com/PDEQQ4w.png);
}

#ui-map-info.js-map-hidden.js-ui-hud-show-icon-pulse {
    background: #f000;
    animation: pulse 1s ease-out 2s infinite alternate;
}

@keyframes pulse {
    0% {
        background-color: rgba(87, 0, 0, 0.8);
    }
    50% {
        background-color: rgba(210, 3, 3, 0.8);
    }
    100% {
        background-color: rgba(255, 0, 0, 0.8);
    }
}


/* ---------- MEDICAL ITEMS ----------> */

#ui-loot-soda,
#ui-loot-painkiller,
#ui-loot-bandage,
#ui-loot-healthkit {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 10px;
    position: relative;
    vertical-align: middle;
}

#ui-loot-soda {
    display: inline-grid;
    grid-template-columns: auto 45px;
    gap: 13px;
}

#ui-loot-soda img.ui-loot-image,
#ui-loot-painkiller img.ui-loot-image,
#ui-loot-bandage img.ui-loot-image,
#ui-loot-healthkit img.ui-loot-image {
    opacity: 0;
    width: 32px;
    height: 32px;
    display: block;
}

#ui-loot-soda::after {
    content: "";
    width: 32px;
    height: 32px;
    background-image: url("https://i.imgur.com/sMXhpzq.png");
    background-repeat: no-repeat;
    background-position: center;
    background-size: contain;
    grid-column: 2;
    justify-self: center;
    align-self: center;
}

#ui-loot-soda.image-left::after {
    grid-column: 1;
}

#ui-loot-painkiller::after {
    content: "";
    width: 128px;
    height: 128px;
    background-image: url("https://i.imgur.com/yp00TxA.png");
    background-repeat: no-repeat;
    background-position: 65px;
    background-size: contain;
    margin-top: 1px;
}

#ui-loot-bandage::after {
    content: "";
    width: 128px;
    height: 128px;
    background-image: url("https://i.imgur.com/CWfrGMt.jpeg");
    background-repeat: no-repeat;
    background-position: 70px;
    background-size: contain;
    margin-top: 1px;
}

#ui-loot-healthkit::after {
    content: "";
    width: 128px;
    height: 128px;
    background-image: url("https://i.imgur.com/THdsXrq.png");
    background-repeat: no-repeat;
    background-position: 70px;
    background-size: contain;
    margin-top: 1px;
}


