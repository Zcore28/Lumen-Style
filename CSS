/* ---------- MENU SCREEN EDITING ----------> */

.surviv-shirts {
    background-position: top;
    background-repeat: no-repeat;
    background-size: cover;
}

#ad-block-left .surviv-shirts {
    background-image: linear-gradient(to top, rgba(43, 126, 143, 0.52), rgba(135, 138, 81, .52)),
    linear-gradient(to right, rgba(250, 245, 136, .11), rgba(93, 80, 60, .3)),
    url("https://giffiles.alphacoders.com/218/218371.gif")!important;
    background-size: cover;
    background-position: center;
    filter: brightness(1);
}

.menu-column.menu-block {
    background: rgba(10, 15, 20, 0.8) !important;
    backdrop-filter: blur(8px);
    border: 1px solid rgba(0, 255, 255, 0.15) !important;
    border-left: 3px solid #374343 !important;
    border-radius: 4px !important;
    box-shadow: 0 0 25px rgba(0, 255, 255, 0.08), inset 0 0 10px rgba(0, 255, 255, 0.05);
    transition: 0.25s ease-in-out;
}

.menu-column.menu-block:hover {
    box-shadow: 0 0 25px rgba(0, 255, 255, 0.25);
    transform: translateY(-1px);
}

#start-menu {
    background: rgba(10, 15, 20, .82) !important;
    backdrop-filter: blur(10px);
    border: 1px solid rgba(0, 255, 255, 0.1) !important;
    border-left: 3px solid #4e6869 !important;
    border-radius: 6px;
    padding: 28px 30px !important;
    min-height: 340px !important;
    box-shadow: 0 0 20px rgba(0, 255, 255, 0.15);
}

.account-details-top-buttons>.account-details-button-wrapper {
    background-repeat: no-repeat;
    background-size: 28px;
    color: #22aec7 !important;
    margin-left: auto;
    margin-right: auto;
    margin-top: 8px;
}

#player-options {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 15px;
}

.player-name-input {
    background: rgba(0, 255, 255, 0.05) !important;
    border: 1px solid rgba(0, 255, 255, 0.25) !important;
    color: #00ffe5 !important;
    text-align: center;
    font-size: 15px;
    text-transform: uppercase;
    font-weight: 600;
    border-radius: 4px;
    outline: none;
    transition: 0.2s;
}

.player-name-input:focus {
    box-shadow: 0 0 10px rgba(0, 255, 255, 0.5);
}

#server-select-main {
    background: rgba(0, 255, 255, 0.05) !important;
    border: 1px solid rgba(0, 255, 255, 0.2) !important;
    color: #00c8c8 !important;
    text-transform: uppercase;
    font-size: 13px;
    border-radius: 4px;
    margin-bottom: 10px;
}

.btn-green,
.btn-darken,
.btn-hollow {
    background-color: rgba(0, 255, 255, 0.08) !important;
    border: 1px solid rgba(0, 255, 255, 0.25) !important;
    color: #0b91ff !important;
    text-transform: uppercase;
    font-weight: 700;
    letter-spacing: 0.8px;
    border-radius: 3px;
}

.btn-green:hover,
.btn-darken:hover {
    background-color: rgba(0, 255, 255, 0.2) !important;
    box-shadow: 0 0 15px rgba(0, 255, 255, 0.4);
}

#btns-quick-start {
    display: grid !important;
    grid-template-columns: 1fr 1fr !important;
    gap: 8px !important;
    margin-top: 8px !important;
}

#btn-start-mode-0 {
    display: block !important;
    width: 100% !important;
    margin-bottom: 10px !important;
}

#btn-start-mode-1,
#btn-start-mode-2 {
    width: 100% !important;
    text-align: center !important;
}

.btns-double-row {
    display: grid !important;
